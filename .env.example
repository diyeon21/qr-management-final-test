# Flask Configuration
SECRET_KEY=change_this_to_a_random_secure_secret_key_in_production
FLASK_DEBUG=0
PORT=5000

# Database Configuration (Option A: Individual Variables)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=qr_maintenance_db

# Database Configuration (Option B: Connection URI for Cloud Providers)
# DATABASE_URL=mysql://username:password@hostname:3306/qr_maintenance_db

# Public URL used in QR codes (e.g., https://your-domain.com or http://192.168.1.5:5000)
PUBLIC_BASE_URL=
