# ==============================================================================
# QR Code-Enabled Equipment Repair & Maintenance Management System
# Production & Deployment Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (in the same directory).
# 2. Update the values below to match your environment.
# 3. Keep your .env file secret and never commit it to source control.
# ==============================================================================

# Application Environment (production / development)
FLASK_ENV=production
FLASK_DEBUG=0

# Secret Key for session signing & CSRF protection
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key

# Database Connection (MySQL / MariaDB)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=qr_maintenance_db
MYSQL_POOL_SIZE=10

# Server Binding
HOST=0.0.0.0
PORT=5000

# Public URL used when phones scan QR codes (no trailing slash).
# If testing from mobile devices on the same Wi-Fi, use your machine's LAN IP:
# Example: http://192.168.1.100:5000
# If behind a domain with SSL:
# Example: https://maintenance.school.edu
PUBLIC_BASE_URL=http://localhost:5000

# Security Settings
# Set SESSION_COOKIE_SECURE=1 if your application is served exclusively over HTTPS
SESSION_COOKIE_SECURE=0

# Reverse Proxy (Set to 1 if running behind Nginx, Apache, Cloudflare, Traefik, or AWS ALB)
BEHIND_PROXY=0
PROXY_FIX_NUM_PROXIES=1

# Max upload size in bytes (default: 8388608 = 8MB)
MAX_CONTENT_LENGTH=8388608
